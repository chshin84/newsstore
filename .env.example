# newsstore 설정 템플릿 — `cp .env.example .env` 후 값 채우기. (.env 는 git 제외)
# 주의: 줄 끝 인라인 주석 금지(Docker --env-file이 값에 포함시킨다). 주석은 별도 줄로.

# ── 런타임 (수집기) ──
# 보안 환경: home(집·기본 SSL 검증) | office(회사·ePrism 루트 CA 주입)
APP_ENV=home
# 저장소 = Firestore 단일. 로컬/테스트는 에뮬레이터(아래) 사용, sqlite 백엔드는 제거됐다.
# 로컬에서 에뮬레이터에 붙이려면(테스트는 docker compose가 자동 설정):
# FIRESTORE_EMULATOR_HOST=firestore-emulator:8080
# 타겟 GCP/Firestore 프로젝트 ID (배포·셋업 공통)
GOOGLE_CLOUD_PROJECT=daily-recap-498506

# ── 배포/셋업 파라미터 (docs/setup.md · docs/operations.md) ──
GCP_REGION=asia-northeast3

# ── FMP (Financial Modeling Prep) — 백엔드 전용 비밀. 절대 커밋·클라이언트 노출 금지 ──
# 시장 지수·환율·국채·펀더멘털 수집(가격 수집기). .env는 gitignore/dockerignore로 보호된다.
# 프로덕션은 Cloud Run env/Secret Manager 사용. 아래 값은 플레이스홀더 — 실 키로 교체하라.
FMP_API_KEY=your-fmp-api-key-here
