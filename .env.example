# newsstore 설정 — `cp .env.example .env` 후 값 채우기. (.env 는 git 제외)
# 주의: 줄 끝 인라인 주석 금지(Docker --env-file이 값에 포함시킴). 주석은 별도 줄로.

# ── 런타임 (수집기) ──
# 보안 환경: home(집·기본 SSL 검증) | office(회사·ePrism 루트 CA 주입)
APP_ENV=home
# 저장소: sqlite(로컬·테스트) | firestore(클라우드)
NEWSSTORE_BACKEND=sqlite
# sqlite DB 경로(컨테이너 내; `-v newsstore_data:/data` 로 영속)
NEWSSTORE_DB=/data/newsstore.db
# 타겟 GCP/Firestore 프로젝트 ID (firestore 백엔드 + 배포·셋업 공통)
GOOGLE_CLOUD_PROJECT=daily-recap-498506

# ── 배포/셋업 파라미터 (docs/setup.md · docs/operations.md) ──
GCP_REGION=asia-northeast3
