rules_version = '2';

// 공개 뷰어용 규칙: items는 누구나 읽기, 클라이언트 쓰기는 전면 금지.
// 수집기(Cloud Run Job)는 Admin SDK라 규칙을 우회하므로 write:false여도 정상 기록됨.
service cloud.firestore {
  match /databases/{database}/documents {

    match /items/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 사이트용 메타(소스 목록 등) — feeds.yaml에서 수집기가 도출해 기록(SSOT)
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Step-2 스토리(내러티브 클러스터) — 사이트 타임라인 UI용 공개 읽기, 쓰기 금지
    // (Processor Job은 Admin SDK라 규칙 우회해 기록)
    match /stories/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 리포트 탭(스펙 2026-06-30 §6) — 데일리 리포트·standing 프레임 공개 읽기, 쓰기 금지
    // (report 패스는 Admin SDK라 규칙 우회해 기록. frames_history는 UI 미소비 — 기본 거부)
    match /reports/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /frames/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 내부 상태(조건부 GET 등)는 비공개
    match /feed_state/{id} {
      allow read, write: if false;
    }

    // 그 외 전부 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
